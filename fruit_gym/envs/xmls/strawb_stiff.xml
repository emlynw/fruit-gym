<mujoco model="strawb_vine">
  <compiler angle="radian" meshdir="assets/"/>

  <default>
    <default class="vine_joint">
      <joint type="ball" stiffness="0.02" armature="0.0001" damping="0.01" actuatorfrclimited="false" group="3"/>
    </default>
    <default class="vine_capsule">
      <geom type="capsule" mass="0.0001"
            solref="0.001 1" solimp="0.97 0.995 0.0005 0.5 2"
            rgba="0.18 0.3 0.12 1"/>
    </default>
  </default>

  <worldbody>
    <body name="vine1" pos="0.45 -0.03 0.9" euler="0 2.64 0">
      <body name="aB_first">
        <joint class="vine_joint" name="aJ_first" pos="0 0 0"/>
        <geom  class="vine_capsule" name="aG0" size="0.0007 0.015"
               pos="0.015 0 0" quat="0.707107 0 -0.707107 0"/>
        <site  name="aS_first" pos="0 0 0" group="3"/>

        <body name="aB_1" pos="0.03 0 0">
          <joint class="vine_joint" name="aJ_1" pos="0 0 0"/>
          <geom  class="vine_capsule" name="aG1" size="0.0007 0.015"
                 pos="0.015 0 0" quat="0.707107 0 -0.707107 0"/>

          <body name="aB_2" pos="0.03 0 0">
            <joint class="vine_joint" name="aJ_2" pos="0 0 0"/>
            <geom  class="vine_capsule" name="aG2" size="0.0007 0.015"
                   pos="0.015 0 0" quat="0.707107 0 -0.707107 0"/>

            <body name="aB_last" pos="0.03 0 0">
              <joint class="vine_joint" name="aJ_last" pos="0 0 0"/>
              <geom  class="vine_capsule" name="aG_last" size="0.0007 0.015"
                     pos="0.015 0 0" quat="0.707107 0 -0.707107 0"/>
              <site  name="aS_last" pos="0.03 0 0" group="3"/>

              <!-- Stem + fruit (angles/poses preserved) -->
              <body name="stem_1" pos="0.091 -0.00024 0.00052" quat="0.707388 0 0 0.706825">
                <geom class="vine_capsule" name="stem_1" size="0.0007 0.012"
                      pos="0.0002 0.049 -0.00055" euler="-1.57 0.0 0.0"/>
                <site name="stem_1" pos="0.0001 0.054 -0.0004" size="0.0012" rgba="0 0 1 1" group="3"/>

                <body name="fruit_1" pos="0.00019 0.0382 -0.00055">
                  <geom name="fruit_1" type="mesh" mesh="sb1" density="400"/>
                  <geom name="calyx_1" type="mesh" mesh="calyx" rgba="0.9 0.9 0.9 1.0"
                        contype="0" conaffinity="0"/>
                </body>
              </body>
              <!-- End stem + fruit -->
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

</mujoco>
