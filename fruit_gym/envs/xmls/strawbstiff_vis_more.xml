                        <site name="aS_last" pos="0.03 0 0" group="3"/>

                        <!-- Stem and fruit unchanged -->
                        <body name="stem1" pos="0.015 0 0">
                          <joint class="vine_joint" name="stem1" pos="0 0 0"/>
                          <site name="joint_stem1" pos="0 0 0" rgba="0 0 1 1" size="0.002"/>
                          <geom name="stem1" type="capsule" size="0.0007 0.015" pos="0.015 0 0" quat="0.707107 0 -0.707107 0" rgba="0.208 0.337 0.149 1"/>
                          <site name="stem1" pos="0.0001 0.054 -0.0004" size="0.0012" rgba="0 0 1 1" group="3"/>
                          <body name="block1" pos="0.03 0 0" euler="0 0 1.57">
                            <geom name="block1" type="mesh" mesh="strawberry_collision" density="400" group="3"/>
                            <geom name="block1_visual" type="mesh" mesh="strawberry" material="strawberry_material" contype="0" conaffinity="0"/>
                            <geom name="leaves1" type="mesh" mesh="strawberry_leaves" rgba="0.9 0.9 0.9 1.0" material="strawberry_leaves" contype="0" conaffinity="0"/>
                          </body>
                        </body>

                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
