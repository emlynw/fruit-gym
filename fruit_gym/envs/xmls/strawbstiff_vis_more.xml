                      <site name="joint_7" pos="0 0 0" rgba="0 0 1 1" size="0.002"/>
                      <geom class="vine_capsule" name="aG7" size="0.0007 0.0075" pos="0.0075 0 0" quat="0.707107 0 -0.707107 0"/>

                      <!-- Link 8 (last) -->
                      <body name="aB_last" pos="0.015 0 0">
                        <joint class="vine_joint" name="aJ_last" pos="0 0 0"/>
                        <site name="joint_last" pos="0 0 0" rgba="0 0 1 1" size="0.002"/>
