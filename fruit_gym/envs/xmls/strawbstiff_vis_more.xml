<mujoco model="strawb_vine">
  <compiler angle="radian" meshdir="assets/"/>

  <asset>
    <texture name="strawb_leaves" type="2d" file="textures/strawberry_leaves_512.png"/>
    <texture name="strawb_texture" type="2d" file="textures/strawberry_fixed_512.png"/>
    <material name="strawberry_material" texture="strawb_texture" shininess="0.01" specular="0.01" reflectance="0.05" texuniform="true"/>
    <material name="strawberry_leaves" texture="strawb_leaves" shininess="0.1" specular="0.1" reflectance="0.5" texuniform="true"/>
    <mesh name="strawberry" file="strawberry_origin.obj" scale="1.0 1.0 1.0"/>
    <mesh name="strawberry_leaves" file="strawberry_leaves_origin.obj" scale="1.0 1.0 1.0"/>
    <mesh name="strawberry_collision" file="strawberry_collision_origin.obj" scale="1.0 1.0 1.0"/>
  </asset>

  <default>
    <default class="vine_joint">
      <joint type="ball" stiffness="0.02" armature="0.0001" damping="0.01" actuatorfrclimited="false" group="3"/>
    </default>
    <default class="vine_capsule">
      <geom type="capsule" mass="0.0001"
            solref="0.001 1" solimp="0.97 0.995 0.0005 0.5 2"
            rgba="0.18 0.3 0.12 1"/>
    </default>
  </default>

  <worldbody>
    <body name="vine1" pos="0.45 -0.03 0.9" euler="0 3.0 0">
      <body name="aB_first">
        <!-- radius unchanged (0.0007), half-length halved (0.0075) -->
        <geom class="vine_capsule" name="aG0" size="0.0007 0.0075" pos="0.0075 0 0" quat="0.707107 0 -0.707107 0"/>
        <site name="aS_first" pos="0 0 0" group="3"/>

        <!-- Link 1 -->
        <body name="aB_1" pos="0.015 0 0">
          <joint class="vine_joint" name="aJ_1" pos="0 0 0"/>
          <site name="joint_1" pos="0 0 0" rgba="0 0 1 1" size="0.002"/>
          <geom class="vine_capsule" name="aG1" size="0.0007 0.0075" pos="0.0075 0 0" quat="0.707107 0 -0.707107 0"/>

          <!-- Link 2 -->
          <body name="aB_2" pos="0.015 0 0">
            <joint class="vine_joint" name="aJ_2" pos="0 0 0"/>
            <site name="joint_2" pos="0 0 0" rgba="0 0 1 1" size="0.002"/>
            <geom class="vine_capsule" name="aG2" size="0.0007 0.0075" pos="0.0075 0 0" quat="0.707107 0 -0.707107 0"/>

            <!-- Link 3 -->
            <body name="aB_3" pos="0.015 0 0">
              <joint class="vine_joint" name="aJ_3" pos="0 0 0"/>
              <site name="joint_3" pos="0 0 0" rgba="0 0 1 1" size="0.002"/>
              <geom class="vine_capsule" name="aG3" size="0.0007 0.0075" pos="0.0075 0 0" quat="0.707107 0 -0.707107 0"/>

              <!-- Link 4 -->
              <body name="aB_4" pos="0.015 0 0">
                <joint class="vine_joint" name="aJ_4" pos="0 0 0"/>
                <site name="joint_4" pos="0 0 0" rgba="0 0 1 1" size="0.002"/>
                <geom class="vine_capsule" name="aG4" size="0.0007 0.0075" pos="0.0075 0 0" quat="0.707107 0 -0.707107 0"/>

                <!-- Link 5 -->
                <body name="aB_5" pos="0.015 0 0">
                  <joint class="vine_joint" name="aJ_5" pos="0 0 0"/>
                  <site name="joint_5" pos="0 0 0" rgba="0 0 1 1" size="0.002"/>
                  <geom class="vine_capsule" name="aG5" size="0.0007 0.0075" pos="0.0075 0 0" quat="0.707107 0 -0.707107 0"/>

                  <!-- Link 6 -->
                  <body name="aB_6" pos="0.015 0 0">
                    <joint class="vine_joint" name="aJ_6" pos="0 0 0"/>
                    <site name="joint_6" pos="0 0 0" rgba="0 0 1 1" size="0.002"/>
                    <geom class="vine_capsule" name="aG6" size="0.0007 0.0075" pos="0.0075 0 0" quat="0.707107 0 -0.707107 0"/>

                    <!-- Link 7 -->
                    <body name="aB_7" pos="0.015 0 0">
