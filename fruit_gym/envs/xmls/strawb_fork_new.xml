<mujoco model="strawb_vine">
  <compiler angle="radian" meshdir="assets/"/>

  <default>
    <default class="vine">
      <joint type="ball" stiffness="0.02" armature="0.0001" damping="0.01" actuatorfrclimited="false"/>
      <geom  type="capsule" size="0.0007" mass="0.0001"
             solref="0.001 1" solimp="0.97 0.995 0.0005 0.5 2"
             rgba="0.208 0.337 0.149 1"/>
    </default>
  </default>

  <asset>
    <texture name="strawb_leaves"   type="2d" file="textures/strawberry_leaves_512.png"/>
    <texture name="strawb_texture"  type="2d" file="textures/r1.png"/>
    <texture name="strawb_green"    type="2d" file="textures/strawberry_fixed_512_green.png"/>
    <material name="strawberry_material" texture="strawb_texture"  shininess="0.01" specular="0.01" reflectance="0.05" texuniform="true"/>
    <material name="strawberry_leaves"   texture="strawb_leaves"   shininess="0.1"  specular="0.1"  reflectance="0.5"  texuniform="true"/>
    <material name="strawberry_material_green"   texture="strawb_green"   shininess="0.1"  specular="0.1"  reflectance="0.5"  texuniform="true"/>

    <mesh name="strawberry"            file="sb5_new.obj"           scale="1 1 1"/>
    <mesh name="strawberry_leaves"     file="strawberry_leaves_origin.obj"    scale="1 1 1"/>
    <mesh name="strawberry_collision"  file="sb5_new.obj" scale="1 1 1"/>
    <mesh name="strawberry_small"     file="strawberry_origin.obj"    scale="0.8 0.8 0.6"/> 
    <mesh name="strawberry_leaves_small"     file="strawberry_leaves_origin.obj"    scale="0.8 0.8 0.6"/>
    <mesh name="strawberry_collision_small"  file="strawberry_collision_origin.obj" scale="0.8 0.8 0.6"/>
  </asset>

  <worldbody>
    <!-- root at origin; rotate/place when attaching in the parent scene -->
    <body name="vine_root">
      <joint class="vine" name="j0"/>

      <!-- main chain -->
      <body name="seg_first">
        <geom class="vine" name="seg0" fromto="0 0 0  0.03 0 0"/>
        <site name="seg_first" pos="0 0 0" group="3"/>

        <body name="seg_1" pos="0.03 0 0">
          <joint class="vine" name="j1"/>
          <geom  class="vine" name="seg1" fromto="0 0 0  0.03 0 0"/>

          <body name="seg_2" pos="0.03 0 0">
            <joint class="vine" name="j2"/>
            <geom  class="vine" name="seg2" fromto="0 0 0  0.03 0 0"/>

            <body name="seg_last" pos="0.03 0 0">
              <joint class="vine" name="j_last"/>
              <geom  class="vine" name="seg3" fromto="0 0 0  0.03 0 0"/>
              <site  name="seg_last" pos="0.03 0 0" group="3"/>

              <body name="fork1" pos="0.03 0 0" euler="-1.5 -0.5 0">
                <joint class="vine" name="j_fork1"/>
                <geom  class="vine" name="seg_fork1" fromto="0 0 0  0.03 0 0"/>
                <site  name="fork1_end" pos="0.03 0 0" group="3"/>
                <body name="stem_a" pos="0.03 0 0">
                  <geom class="vine" name="stem_a_caps" fromto="0 0 0  0.024 0 0"/>
                  <site name="stem_a_site" pos="0.024 0 0" size="0.0012" rgba="0 0 1 1" group="3"/>
                  <body name="fruit_a" pos="0.024 0 0" euler="0 0 1.57">
                    <geom name="fruit_a_col"   type="mesh" mesh="strawberry_collision_small" density="400" group="3"/>
                    <geom name="fruit_a_vis"   type="mesh" mesh="strawberry_small"          material="strawberry_material_green" contype="0" conaffinity="0" rgba="0.9 0.9 0.9 1"/>
                    <geom name="leaves_a_vis"  type="mesh" mesh="strawberry_leaves_small"   material="strawberry_leaves"   contype="0" conaffinity="0"/>
                  </body>
                </body>
              </body>

              <!-- Branch B (fork): one more vine segment, then stem + fruit -->
              <body name="fork2" pos="0.03 0 0">
                <joint class="vine" name="j_fork2"/>
                <geom  class="vine" name="seg_fork2" fromto="0 0 0  0.03 0 0"/>
                <site  name="fork2_end" pos="0.03 0 0" group="3"/>
                <body name="stem_b" pos="0.03 0 0">
                  <geom class="vine" name="stem_b_caps" fromto="0 0 0  0.024 0 0"/>
                  <site name="stem_b_site" pos="0.024 0 0" size="0.0012" rgba="0 0 1 1" group="3"/>
                  <body name="fruit_b" pos="0.024 0 0" euler="0 0 1.57">
                    <geom name="fruit_b_col"   type="mesh" mesh="strawberry_collision" density="400" group="3"/>
                    <geom name="fruit_b_vis"   type="mesh" mesh="strawberry"          material="strawberry_material" contype="0" conaffinity="0" rgba="0.7 0.7 0.7 1"/>
                    <geom name="leaves_b_vis"  type="mesh" mesh="strawberry_leaves"   material="strawberry_leaves"   contype="0" conaffinity="0"/>
                  </body>
                </body>
              </body>

            </body>
          </body>
        </body>
      </body>
      <!-- end main chain -->

    </body>
  </worldbody>
</mujoco>
