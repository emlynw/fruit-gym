<!-- vine.xml -->
<mujoco model="vine">

  <asset>
    <mesh name="strawberry"               file="strawberry.obj"               scale="0.12 0.12 0.12"/>
    <mesh name="strawberry_leaves"        file="strawberry_leaves.obj"        scale="0.12 0.12 0.12"/>
    <mesh name="strawberry_collision"     file="strawberry_collision.obj"     scale="0.12 0.12 0.12"/>

    <mesh name="strawberry_big"           file="strawberry.obj"               scale="0.13 0.13 0.13"/>
    <mesh name="strawberry_leaves_big"    file="strawberry_leaves.obj"        scale="0.13 0.13 0.13"/>
    <mesh name="strawberry_collision_big" file="strawberry_collision.obj"     scale="0.13 0.13 0.13"/>

    <mesh name="strawberry_small"           file="strawberry.obj"             scale="0.11 0.11 0.11"/>
    <mesh name="strawberry_leaves_small"    file="strawberry_leaves.obj"      scale="0.11 0.11 0.11"/>
    <mesh name="strawberry_collision_small" file="strawberry_collision.obj"   scale="0.11 0.11 0.11"/>
  </asset>
  <worldbody>
    <!-- a short chain of capsules with ball joints -->
    <body name="seg_first">
      <joint name="j_first" type="ball" group="3" actuatorfrclimited="false" damping="0.001"/>
      <geom  name="g0" size="0.0007 0.015" pos="0.015 0 0"
             quat="0.707107 0 -0.707107 0" type="capsule" solref="0.01 0.1" mass="0.0001"
             rgba="0.208 0.337 0.149 1"/>
      <site  name="s_first" pos="0 0 0" group="3"/>

      <body name="seg_1" pos="0.03 0 0">
        <joint name="j_1" type="ball" group="3" actuatorfrclimited="false" damping="0.001"/>
        <geom  name="g1" size="0.0007 0.015" pos="0.015 0 0"
               quat="0.707107 0 -0.707107 0" type="capsule" solref="0.01 0.1" mass="0.0001"
               rgba="0.208 0.337 0.149 1"/>

        <body name="seg_2" pos="0.03 0 0">
          <joint name="j_2" type="ball" group="3" actuatorfrclimited="false" damping="0.001"/>
          <geom  name="g2" size="0.0007 0.015" pos="0.015 0 0"
                 quat="0.707107 0 -0.707107 0" type="capsule" solref="0.01 0.1" mass="0.0001"
                 rgba="0.208 0.337 0.149 1"/>

          <body name="seg_last" pos="0.03 0 0">
            <joint name="j_last" type="ball" group="3" actuatorfrclimited="false" damping="0.001"/>
            <geom  name="g3" size="0.0007 0.015" pos="0.015 0 0"
                   quat="0.707107 0 -0.707107 0" type="capsule" solref="0.01 0.1" mass="0.0001"
                   rgba="0.208 0.337 0.149 1"/>
            <site  name="s_last" pos="0.03 0 0" group="3"/>

            <!-- strawberry stem + fruit cluster -->
            <body name="stem" pos="0.091 -0.00024 0.00052" quat="0.707388 0 0 0.706825">
              <geom name="stem_geom" type="capsule" size="0.0007 0.014"
                    pos="0.0002 0.049 -0.00055" euler="-1.57 0 0"
                    rgba="0.208 0.337 0.149 1"/>
              <site name="stem" pos="0.0001 0.054 -0.0004" size="0.0012" rgba="0 0 1 1" group="3"/>

              <!-- normal size -->
              <body name="block" pos="0.0 0.001 0.0">
                <geom name="block_collision" type="mesh" mesh="strawberry_collision" density="400" group="3"/>
                <geom name="block_visual"    type="mesh" mesh="strawberry" contype="0" conaffinity="0"/>
                <geom name="leaves"          type="mesh" mesh="strawberry_leaves" contype="0" conaffinity="0"/>
              </body>

              <!-- big -->
              <body name="block_big" pos="0 -0.003 0">
                <geom name="block_big_collision" type="mesh" mesh="strawberry_collision_big" density="400" group="3"/>
                <geom name="block_big_visual"    type="mesh" mesh="strawberry_big" contype="0" conaffinity="0" group="3"/>
                <geom name="leaves_big"          type="mesh" mesh="strawberry_leaves_big" contype="0" conaffinity="0" group="3"/>
              </body>

              <!-- small -->
              <body name="block_small" pos="0 0.003 0">
                <geom name="block_small_collision" type="mesh" mesh="strawberry_collision_small" density="400" group="3"/>
                <geom name="block_small_visual"    type="mesh" mesh="strawberry_small" contype="0" conaffinity="0" group="3"/>
                <geom name="leaves_small"          type="mesh" mesh="strawberry_leaves_small" contype="0" conaffinity="0" group="3"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Local self-collision exclusions for the chain -->
  <contact>
    <exclude body1="seg_first" body2="seg_1"/>
    <exclude body1="seg_1"    body2="seg_2"/>
    <exclude body1="seg_2"    body2="seg_last"/>
    <exclude body1="seg_last" body2="stem"/>
  </contact>
</mujoco>
