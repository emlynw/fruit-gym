<mujoco model="strawb_vine">
  <compiler angle="radian" meshdir="assets/"/>

  <default>
    <default class="vine">
      <joint type="ball" stiffness="0.02" armature="0.0001" damping="0.01" actuatorfrclimited="false"/>
      <geom  type="capsule" size="0.0007" mass="0.0001" solref="0.001 1" solimp="0.97 0.995 0.0005 0.5 2" rgba="0.208 0.337 0.149 1"/>
    </default>
  </default>

  <asset>
    <texture name="strawb_leaves"   type="2d" file="textures/strawberry_leaves_512.png"/>
    <texture name="strawb_texture"  type="2d" file="textures/strawberry_fixed_512.png"/>
    <material name="strawberry_material" texture="strawb_texture"  shininess="0.01" specular="0.01" reflectance="0.05" texuniform="true"/>
    <material name="strawberry_leaves"   texture="strawb_leaves"   shininess="0.1"  specular="0.1"  reflectance="0.5"  texuniform="true"/>

    <mesh name="strawberry"            file="strawberry_origin.obj"           scale="1 1 1"/>
    <mesh name="strawberry_leaves"     file="strawberry_leaves_origin.obj"    scale="1 1 1"/>
    <mesh name="strawberry_collision"  file="strawberry_collision_origin.obj" scale="1 1 1"/>
  </asset>

  <worldbody>
    <!-- root at origin; rotate/place when attaching in the parent scene -->
    <body name="vine_root">
      <joint class="vine" name="aJ_0"/>
      <!-- segment 0 fixed root segment -->
      <body name="seg_first">
        <geom class="vine" name="aG0" fromto="0 0 0  0.03 0 0"/>
        <site name="seg_first" pos="0 0 0" group="3"/>
        <!-- segment 1 -->
        <body name="seg_1" pos="0.03 0 0">
          <joint class="vine" name="aJ_1"/>
          <geom class="vine"  name="aG1" fromto="0 0 0  0.03 0 0"/>
          <!-- segment 2 -->
          <body name="seg_2" pos="0.03 0 0">
            <joint class="vine" name="aJ_2"/>
            <geom class="vine"  name="aG2" fromto="0 0 0  0.03 0 0"/>
            <!-- segment 3 last -->
            <body name="seg_last" pos="0.03 0 0">
              <joint class="vine" name="aJ_last"/>
              <geom class="vine"  name="aG3" fromto="0 0 0  0.03 0 0"/>
              <site  name="seg_last" pos="0.03 0 0" group="3"/>
              <!-- stem and fruit cluster -->
              <body name="stem1" pos="0.03 0 0">
                <geom class="vine" name="stem1" fromto="0 0 0  0.024 0 0"/>
                <site name="stem1" pos="0 0.024 0" size="0.0012" rgba="0 0 1 1" group="3"/>
                <body name="block1" pos="0.024 0 0" euler="0 0 1.57">
                  <geom name="block1"         type="mesh" mesh="strawberry_collision" density="400" group="3"/>
                  <geom name="block1_visual"  type="mesh" mesh="strawberry"          material="strawberry_material" contype="0" conaffinity="0" rgba="0.7 0.7 0.7 1"/>
                  <geom name="leaves1"        type="mesh" mesh="strawberry_leaves"   material="strawberry_leaves"   contype="0" conaffinity="0"/>
                </body>
              </body>
              <!-- end stem and fruit cluster -->

            </body>
          </body>
        </body>
      </body>

    </body>
  </worldbody>
</mujoco>
