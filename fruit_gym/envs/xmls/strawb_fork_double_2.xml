<mujoco model="strawb_vine">
  <compiler angle="radian" meshdir="assets/"/>

  <default>
    <default class="vine">
      <joint type="ball" stiffness="0.01" armature="0.0001" damping="0.01" actuatorfrclimited="false"/>
      <geom  type="capsule" size="0.0007" mass="0.0001"
             solref="0.001 1" solimp="0.97 0.995 0.0005 0.5 2"
             rgba="0.18 0.3 0.12 1"/>
    </default>
  </default>

  <worldbody>
    <!-- root at origin; rotate/place when attaching in the parent scene -->
    <body name="vine_root" pos="0.45 -0.03 0.9" euler="0 2.64 0">

      <!-- main chain -->
      <body name="seg_first">
        <geom class="vine" name="seg0" fromto="0 0 0  0.03 0 0"/>
        <site name="seg_first" pos="0 0 0" group="3"/>

        <body name="seg_1" pos="0.03 0 0">
          <joint class="vine" name="j1"/>
          <geom  class="vine" name="seg1" fromto="0 0 0  0.03 0 0"/>

          <body name="seg_2" pos="0.03 0 0">
            <joint class="vine" name="j2"/>
            <geom  class="vine" name="seg2" fromto="0 0 0  0.03 0 0"/>

            <!--higher fork that splits into two fruit-->
            <body name="fork_top" pos="0.03 0 0">
              <joint class="vine" name="j_fork_top"/>
              <geom  class="vine" name="seg_fork_top" fromto="0 0 0  0.02 0 0"/>
              <!-- branch 1 -->
              <body name="branch_1" pos="0.02 0 0" euler="-1.2 0.2 0.4">
                <joint class="vine" name="j_branch_c"/>
                <geom  class="vine" name="seg_branch_c" fromto="0 0 0  0.03 0 0"/>
                <body name="stem_1" pos="0.03 0 0">
                  <geom class="vine" name="stem_c_caps" fromto="0 0 0  0.024 0 0"/>
                  <site name="stem_1" pos="0.024 0 0" size="0.0012" rgba="0 0 1 1" group="3"/>
                  <body name="fruit_1" pos="0.024 0 0" euler="0 0 1.57">
                    <geom name="fruit_1"   type="mesh" mesh="sb_1" density="400"/>
                    <geom name="calyx_1"  type="mesh" mesh="calyx"   contype="0" conaffinity="0"/>
                  </body>
                </body>
              </body>

              <!-- branch 2 -->
              <body name="branch_2" pos="0.02 0 0" euler="-1.0 -0.3 -0.5">
                <joint class="vine" name="j_branch_d"/>
                <geom  class="vine" name="seg_branch_d" fromto="0 0 0  0.03 0 0"/>
                <body name="stem_2" pos="0.03 0 0">
                  <geom class="vine" name="stem_2_caps" fromto="0 0 0  0.024 0 0"/>
                  <site name="stem_2" pos="0.024 0 0" size="0.0012" rgba="0 0 1 1" group="3"/>
                  <body name="fruit_2" pos="0.024 0 0" euler="0 0 1.57">
                    <geom name="fruit_2"   type="mesh" mesh="sb_1" density="400"/>
                    <geom name="calyx_2"  type="mesh" mesh="calyx"   contype="0" conaffinity="0"/>
                  </body>
                </body>
              </body>
            </body>
            <!-- END higher fork -->

            <!-- extend main chain with a few more segments -->
            <body name="seg_3" pos="0.03 0 0">
              <joint class="vine" name="j3"/>
              <geom  class="vine" name="seg3" fromto="0 0 0  0.03 0 0"/>

              <body name="seg_4" pos="0.03 0 0">
                <joint class="vine" name="j4"/>
                <geom  class="vine" name="seg4" fromto="0 0 0  0.03 0 0"/>

                <body name="seg_last" pos="0.03 0 0">
                  <joint class="vine" name="j_last"/>
                  <geom  class="vine" name="seg5" fromto="0 0 0  0.03 0 0"/>
                  <site  name="seg_last" pos="0.03 0 0" group="3"/>

                  <!-- lower fork -->
                  <body name="fork1" pos="0.03 0 0" euler="-1.5 -0.5 0">
                    <joint class="vine" name="j_fork1"/>
                    <geom  class="vine" name="seg_fork1" fromto="0 0 0  0.03 0 0"/>
                    <site  name="fork1_end" pos="0.03 0 0" group="3"/>
                    <body name="stem_3" pos="0.03 0 0">
                      <geom class="vine" name="stem_3_caps" fromto="0 0 0  0.024 0 0"/>
                      <site name="stem_3" pos="0.024 0 0" size="0.0012" rgba="0 0 1 1" group="3"/>
                      <body name="fruit_3" pos="0.024 0 0" euler="0 0 1.57">
                        <geom name="fruit_3"   type="mesh" mesh="sb_1" density="400"/>
                        <geom name="calyx_3"  type="mesh" mesh="calyx"   contype="0" conaffinity="0"/>
                      </body>
                    </body>
                  </body>

                  <body name="fork2" pos="0.03 0 0">
                    <joint class="vine" name="j_fork2"/>
                    <geom  class="vine" name="seg_fork2" fromto="0 0 0  0.03 0 0"/>
                    <site  name="fork2_end" pos="0.03 0 0" group="3"/>
                    <body name="stem_4" pos="0.03 0 0">
                      <geom class="vine" name="stem_4_caps" fromto="0 0 0  0.024 0 0"/>
                      <site name="stem_4" pos="0.024 0 0" size="0.0012" rgba="0 0 1 1" group="3"/>
                      <body name="fruit_4" pos="0.024 0 0" euler="0 0 1.57">
                        <geom name="fruit_4"   type="mesh" mesh="sb_1" density="400"/>
                        <geom name="calyx_4"  type="mesh" mesh="calyx"   contype="0" conaffinity="0"/>
                      </body>
                    </body>
                  </body>

                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
      <!-- end main chain -->

    </body>
  </worldbody>
</mujoco>
