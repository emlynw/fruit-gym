<?xml version="1.0" encoding="utf-8"?>
<mujoco model="strawb_vine_leaves_flower_clover">
  <compiler angle="radian" meshdir="assets"/>

  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <default>
    <geom rgba="0.8 0.8 0.8 1" condim="3" solimp="0.95 0.99 0.001" solref="0.004 1"/>
    <joint damping="0.005" armature="0.001" stiffness="0.02"/>
  </default>

  <asset>
    <!-- Meshes only (no textures). Leaf scaled down by 0.4 -->
    <mesh name="leaf" file="leaf.obj" scale="0.4 0.4 0.4"/>
  </asset>

  <worldbody>
    <body name="vine1" pos="0.45 -0.03 0.9" euler="0 2.64 0">

      <body name="aB_first">
        <!-- Base segment -->
        <geom name="aG0" type="capsule" size="0.0007 0.015" pos="0.015 0 0"
              quat="0.707107 0 -0.707107 0" mass="0.0001" rgba="0.208 0.337 0.149 1"/>
        <site name="aS_first" pos="0 0 0" group="3"/>

        <body name="aB_1" pos="0.03 0 0">
          <joint name="aJ_1" type="ball" pos="0 0 0" group="3"
                 actuatorfrclimited="false"/>
          <geom name="aG1" type="capsule" size="0.0007 0.015" pos="0.015 0 0"
                quat="0.707107 0 -0.707107 0" mass="0.0001" rgba="0.208 0.337 0.149 1"/>

          <body name="aB_2" pos="0.03 0 0">
            <joint name="aJ_2" type="ball" pos="0 0 0" group="3"
                   actuatorfrclimited="false"/>
            <geom name="aG2" type="capsule" size="0.0007 0.015" pos="0.015 0 0"
                  quat="0.707107 0 -0.707107 0" mass="0.0001" rgba="0.208 0.337 0.149 1"/>

            <body name="aB_last" pos="0.03 0 0">
              <joint name="aJ_last" type="ball" pos="0 0 0" group="3"
                     actuatorfrclimited="false"/>
              <geom name="aG3" type="capsule" size="0.0007 0.015" pos="0.015 0 0"
                    quat="0.707107 0 -0.707107 0" mass="0.0001" rgba="0.208 0.337 0.149 1"/>
              <site name="aS_last" pos="0.03 0 0" group="3"/>

              <!-- Petiole to the leaf/flower cluster -->
              <body name="petiole" pos="0.09 -0.00024 0.00052" quat="0.707388 0 0 0.706825">
                <geom name="petiole_caps" type="capsule" size="0.0007 0.012"
                      pos="0.0002 0.049 -0.00055" euler="-1.57 0 0" rgba="0.208 0.337 0.149 1"/>
                <site name="petiole_site" pos="0.0001 0.054 -0.0004" size="0.0012" rgba="0 0 1 1" group="3"/>

                <!-- Hub carries three child leaf bodies (each with a ball joint) -->
                <body name="hub" pos="0.00019 0.0382 -0.00055">

                  <!-- Leaf A body (+X) -->
                  <body name="leafA_body" pos="0.006 0 0" euler="0 0 0">
                    <joint name="leafA_joint" type="ball" pos="0 0 0" damping="0.0005" armature="0.0001" stiffness="0.01"/>
                    <geom  name="leaf_A" type="mesh" mesh="leaf" mass="0.001" rgba="0.25 0.60 0.25 1"/>
                  </body>

                  <!-- Leaf B body (+Y), flipped upside down (roll 180°) and yaw +90° -->
                  <body name="leafB_body" pos="0 0.006 0" euler="3.1415926 0 1.5707963">
                    <joint name="leafB_joint" type="ball" pos="0 0 0" damping="0.0005" armature="0.0001" stiffness="0.01"/>
                    <geom  name="leaf_B" type="mesh" mesh="leaf" mass="0.001" rgba="0.22 0.55 0.22 1"/>
                  </body>

                  <!-- Leaf C body (−X), yaw 180° -->
                  <body name="leafC_body" pos="-0.006 0 0" euler="0 0 3.1415926">
                    <joint name="leafC_joint" type="ball" pos="0 0 0" damping="0.0005" armature="0.0001" stiffness="0.01"/>
                    <geom  name="leaf_C" type="mesh" mesh="leaf" mass="0.001" rgba="0.20 0.50 0.20 1"/>
                  </body>

                </body>
              </body>

            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
